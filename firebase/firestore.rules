rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Shared data: all visitors read the same projects and rankings.
    // Shared site-wide documents, one verified Email/Password owner can write.
    function isEditor() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == "movaeriahhistory@gmail.com";
    }
    function validProject() {
      return request.resource.data.schema == "mep-video-project"
        && request.resource.data.shorts is list
        && request.resource.data.shorts.size() <= 30;
    }
    match /mepProjects/{projectId} {
      allow read: if true;
      allow create, update: if isEditor() && validProject();
      allow delete: if false; // Never delete past projects from the public editor.
    }
    // One video document per Short; contains scenes, scripts, captions and production workflow history.
    match /mepVideos/{videoId} {
      allow read: if true;
      allow create, update: if isEditor()
        && request.resource.data.schema == "mep-video-short-v1"
        && request.resource.data.projectId is string
        && request.resource.data.shortId is string
        && request.resource.data.payload is map;
      allow delete: if false;
    }
    match /mepProjectHistory/{historyId} {
      allow read: if true;
      allow create: if isEditor()
        && request.resource.data.schema == "mep-project-activity-v1";
      allow update, delete: if false;
    }
    match /mepFlagRatings/{stateCode} {
      allow read: if true;
      allow create, update: if isEditor()
        && stateCode.matches('^[A-Z]{2}$')
        && request.resource.data.schema == "mep-flag-rating-v1"
        && request.resource.data.code == stateCode
        && request.resource.data.grade in ["", "A", "B", "C", "D", "F"]
        && request.resource.data.done is bool
        && request.resource.data.episode is int
        && request.resource.data.episode >= 1
        && request.resource.data.episode <= 17;
      allow delete: if false;
    }
    match /mepLibrary/{docId} {
      allow read: if true;
      allow create, update: if isEditor()
        && request.resource.data.schema == "mep-library-v4";
      allow delete: if false;
    }
    match /mepCharacters/{characterId} {
      allow read: if true;
      allow create, update: if isEditor()
        && request.resource.data.schema == "mep-character-v3";
      allow delete: if false;
    }
    match /mepAnimations/{animationId} {
      allow read: if true;
      allow create, update: if isEditor()
        && request.resource.data.schema == "mep-animation-v3";
      allow delete: if false;
    }
    match /mepAssets/{assetId} {
      allow read: if true;
      allow create, update: if isEditor()
        && request.resource.data.schema == "mep-asset-v1"
        && request.resource.data.dataUrl.size() < 850000;
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
